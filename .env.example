# copy to .env (gitignored). blank values count as unset and fall back to the default.

# --- model access (the proxy uses these; no harness ever sees them) ---
# OpenAI-compatible base URL: Ollama on a server, or a hosted API
BENCH_BASE_URL=http://100.124.74.45:11434/v1
# the main and safety models are not set here: every harness names them in its harness.json (models.main, models.safety)
# default judge model (the /judge/v1 route), for a benchmark whose benchmark.json names no judge
# default: qwen3:8b. it may live on another provider: set the url and key too
BENCH_JUDGE_MODEL=
BENCH_JUDGE_BASE_URL=
BENCH_JUDGE_API_KEY=
# required by hosted APIs, ignored by Ollama (default: none)
BENCH_API_KEY=

# --- benchmark defaults enforced by the proxy ---
# temperature injected when a harness does not set one (default: 0)
BENCH_TEMPERATURE=
# per model call, in milliseconds (default: 120000). a thinking judge under load may need 300000
BENCH_TIMEOUT_MS=
# model calls a harness may make per run on the guarded and safety routes (default: 20)
BENCH_MAX_CALLS=
# judge calls the graders may make per run (default: 100)
BENCH_MAX_JUDGE_CALLS=

# --- reporting ---
# prices in $ per 1M tokens, for providers that report no cost (ollama). openrouter
# reports the exact cost of every request, and that is used when present
BENCH_COST_IN=
BENCH_COST_OUT=

# --- sandbox ---
# docker: every run in a fresh hardened container (needs `npm run sandbox:build`)
# unset: every run as an isolated child process
BENCH_SANDBOX=
